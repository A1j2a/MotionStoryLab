# ==================================================
# AI Kids Video Studio Environment Configuration
# ==================================================

APP_ENV=local

# Network & Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./projects/studio.db

# OpenRouter AI & Deep Research (Get free key at https://openrouter.ai/keys)
OPENROUTER_ENABLED=true
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o

# External AI & Audio Services
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022
SUNO_API_KEY=
SUNO_API_URL=
N8N_URL=http://127.0.0.1:5678
COMFYUI_URL=http://127.0.0.1:8188
KOKORO_TTS_URL=http://127.0.0.1:8880

# Directories
PROJECT_DIR=./projects
LOG_DIR=./logs

# Defaults
DEFAULT_LANGUAGE=en
DEFAULT_DURATION_MIN=5
DEFAULT_DURATION_MAX=7
DEFAULT_VIDEO_TYPE="Nursery Rhyme"
DEFAULT_VISUAL_STYLE="3D Cartoon"
DEFAULT_TARGET_AGE="Kids"

# Optional YouTube API Integration
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_CREDENTIALS_FILE=
OPENROUTER_VIDEO_ENABLED=false
OPENROUTER_VIDEO_MODEL=bytedance/seedance-2.0-mini
VIDEO_ASPECT_RATIO=16:9
THUMBNAIL_GENERATOR_ENABLED=true
THUMBNAIL_ENGINE=high_ctr_graphic
THUMBNAIL_MODEL=high_ctr_graphic
THUMBNAIL_ASPECT_RATIO=16:9
AUTO_SONG_GENERATION_ENABLED=true
