# ==================================================
# AI Kids Video Studio Environment Configuration
# ==================================================

APP_ENV=local

# Network & Ports
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Database
DATABASE_URL=sqlite+aiosqlite:///./projects/studio.db

# Primary AI Provider ("ollama", "openrouter", "claude", "omniroute", "fallback")
AI_PROVIDER=ollama

# OpenRouter AI & Deep Research (Get key at https://openrouter.ai/keys)
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-r1:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Video Generation Provider ("wan" [default] or "blender" [local fallback])
VIDEO_PROVIDER=wan
FAL_KEY=
WAN_MODEL=fal-ai/wan-flf2v
WAN_RESOLUTION=720p
WAN_FPS=16
WAN_NUM_FRAMES=81
WAN_INFERENCE_STEPS=30
WAN_GUIDE_SCALE=5
WAN_ENABLE_SAFETY=true
WAN_MAX_RETRIES=3
ENABLE_SCENE_VALIDATION=false
VIDEO_GENERATION_TEST_MODE=false

# Local Ollama AI Engine (Port 11434)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude Integration (Optional)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# External Local AI Services
OMNIROUTE_URL=http://127.0.0.1:20128
OMNIROUTE_API_KEY=
OMNIROUTE_MODEL=omniroute-default
N8N_URL=http://127.0.0.1:5678
COMFYUI_URL=http://127.0.0.1:8188
KOKORO_TTS_URL=http://127.0.0.1:8880

# Audio & Song Generation (Suno AI or Local Chime Engine)
SUNO_API_KEY=
SUNO_API_URL=
AUTO_SONG_GENERATION_ENABLED=true

# Thumbnail & Rendering Settings
THUMBNAIL_GENERATOR_ENABLED=true
THUMBNAIL_ENGINE=high_ctr_graphic
THUMBNAIL_MODEL=high_ctr_graphic
THUMBNAIL_ASPECT_RATIO=16:9
VIDEO_ASPECT_RATIO=16:9
MAX_RENDER_JOBS=1
MAX_AI_JOBS=1

# Directories
PROJECT_DIR=./projects
LOG_DIR=./logs

# Studio Defaults
DEFAULT_LANGUAGE=en
DEFAULT_DURATION_MIN=5
DEFAULT_DURATION_MAX=7
DEFAULT_VIDEO_TYPE="Nursery Rhyme"
DEFAULT_VISUAL_STYLE="3D Cartoon"
DEFAULT_TARGET_AGE="Kids"

# YouTube Data API Integration (Optional)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CLIENT_SECRETS_FILE=
YOUTUBE_CREDENTIALS_FILE=
